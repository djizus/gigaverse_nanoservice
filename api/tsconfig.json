{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/domains/*": ["src/domains/*"],
      "@/shared/*": ["src/shared/*"],
      "@/infrastructure/*": ["src/infrastructure/*"],
      "@/api/*": ["src/api/*"]
    }
  },
  "include": [
    "src/**/*",
    "server.ts",
    "client.ts",
    "tsconfig.json",
    "index.ts",
    "test-agents.ts",
    "test-dungeon.ts",
    "test-hybrid-system.ts",
    "test-nano-services.ts"
  ],
  "exclude": ["node_modules", "dist", "server.old.ts"]
}
