# Configuration des clés API
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...  # Optionnel

# Configuration Notion
NOTION_API_KEY=ntn_...

# Configuration Discord
DISCORD_TOKEN=...
DISCORD_BOT_NAME=YourBotName

# Configuration Supabase
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_API_KEY=eyJhbGciOiJS...
# Pour l'authentification, récupérez la clé JWT depuis: Settings > API > JWT Secret dans votre dashboard Supabase
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# Configuration mémoire
MEMORY_TYPE=supabase  # Options: supabase, mongodb, in-memory

# Autres configurations
USE_CHROMA=false
KNOWLEDGE_DIR=./knowledge
PORT=3000