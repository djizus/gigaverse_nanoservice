# Caddyfile for reverse proxy with automatic HTTPS
# Replace example.com with your actual domain

# Global options
{
    # Email for Let's Encrypt notifications (optional but recommended)
    # email admin@example.com
    
    # Staging Let's Encrypt for testing (remove for production certs)
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Staging API
api-staging.aifred.cloud {
    # CORS is handled by the NestJS API, not Caddy
    # to avoid duplicate headers

    # Reverse proxy to staging API on port 3001
    reverse_proxy 172.17.0.1:3001 {
        # Use Docker bridge gateway IP on Linux
        fail_duration 30s
    }

    # Logging
    log {
        output file /data/logs/staging-access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

# Production API
api.aifred.cloud {
    # CORS is handled by the NestJS API, not Caddy
    # to avoid duplicate headers

    # Reverse proxy to production API on port 3000
    reverse_proxy 172.17.0.1:3000 {
        # Use Docker bridge gateway IP on Linux
        fail_duration 30s
    }

    # Logging
    log {
        output file /data/logs/production-access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

# Health check endpoint for Caddy itself
:2019 {
    respond /health "OK" 200
}