{
  "name": "gigaverse-dungeon-nanoservice",
  "version": "1.0.0",
  "description": "Real-time dungeon running service for Gigaverse with micropayment integration",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run server.ts",
    "start": "bun run server.ts",
    "test": "bun test tests/daydreams.poc.test.ts",
    "client": "bun run test-dungeon.ts",
    "client:examples": "bun run test-dungeon.ts --duplicate",
    "web": "bun --cwd front/daydreams-ui run dev",
    "web:build": "bun --cwd front/daydreams-ui run build",
    "web:preview": "bun --cwd front/daydreams-ui run preview",
    "deploy": "./deploy.sh",
    "deploy:prod": "GCP_PROJECT_ID=your-prod-project ./deploy.sh",
    "test:deployed": "curl https://ai-assistant.agent.daydreams.systems/health"
  },
  "keywords": ["gigaverse", "dungeon", "nanoservice", "x402", "micropayments", "real-time"],
  "author": "Daydreams AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/daydreamsai/gigaverse-dungeon-nanoservice"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.23",
    "@daydreamsai/ai-sdk-provider": "0.1.3",
    "@daydreamsai/core": "0.3.18",
    "@hono/node-server": "^1.18.2",
    "@supabase/supabase-js": "^2.57.0",
    "ai": "^5.0.29",
    "dotenv": "^17.2.1",
    "hono": "^4.9.1",
    "viem": "2.33.3",
    "x402-fetch": "^0.5.1",
    "x402-hono": "^0.5.2",
    "zod": "^4.1.5"
  }
}
